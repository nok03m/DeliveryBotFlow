    {
      "parameters": {
        "jsCode": "const texto = $input.first().json.pantalla_actual;\nconst resultado = texto.split('/').pop();\n\nreturn {\n  json: {\n    resultado\n  }\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        144
      ],
      "id": "fbbe4f4a-7f54-447e-b95a-3746536bb278",
      "name": "Extraer categoria seleccionada"
    },
    {
      "parameters": {
        "jsCode": "// 1. Obtener todos los elementos que llegan de la entrada\nconst items = $input.all();\n\n// 2. Generar las filas de la tabla iterando dinámicamente sobre la lista\nconst rows = items.map(item => {\n  const data = item.json;\n  \n  // Extraer propiedades (soporta 'stock' o 'cantidad' por compatibilidad)\n  const id = data.id_producto || data.id || 'N/A';\n  const nombre = data.nombre || 'N/A';\n  const cantidad = data.cantidad !== undefined ? data.cantidad : (data.stock !== undefined ? data.stock : 0);\n  const precio = data.precio !== undefined ? Number(data.precio).toFixed(2) : '0.00';\n\n  return `\n    <tr>\n      <td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">${id}</td>\n      <td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">${nombre}</td>\n      <td style=\"padding: 10px; border-bottom: 1px solid #ddd; text-align: center;\">${cantidad}</td>\n      <td style=\"padding: 10px; border-bottom: 1px solid #ddd; text-align: right;\">$${precio}</td>\n    </tr>\n  `;\n}).join('');\n\n// 3. Estructurar la plantilla HTML completa\nconst htmlOutput = `\n  <div style=\"font-family: Arial, sans-serif; max-width: 600px; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden;\">\n    <table style=\"width: 100%; border-collapse: collapse; text-align: left;\">\n      <thead>\n        <tr style=\"background-color: #f4f4f7; color: #333; border-bottom: 2px solid #ddd;\">\n          <th style=\"padding: 12px 10px;\">ID</th>\n          <th style=\"padding: 12px 10px;\">Producto</th>\n          <th style=\"padding: 12px 10px; text-align: center;\">Cantidad</th>\n          <th style=\"padding: 12px 10px; text-align: right;\">Precio</th>\n        </tr>\n      </thead>\n      <tbody>\n        ${rows}\n      </tbody>\n    </table>\n  </div>\n`;\n\n// 4. Retornar la cadena HTML en un único objeto de salida\nreturn [{ json: { html: htmlOutput } }];"
      },
