    {
      "parameters": {
        "jsCode": "let sesion = $input.first().json.obtener_sesion\n\nlet carrito = []\n\nif(sesion.carrito_temporal != \"\"){\n  carrito = JSON.parse(sesion.carrito_temporal)\n}\n\nconst cantidadSolicitada = parseInt($('Capturar mensaje bot').first().json.message.text.split(' ')[2])\n\nconst existeEnCarrito = carrito.findIndex((el) => el.id == $('Stock suficiente').first().json.id_producto)\n\nif(existeEnCarrito != -1){\n  let copia = carrito[existeEnCarrito]\n  copia['cantidad'] += cantidadSolicitada\n  copia['total_pagar'] = copia['cantidad'] * copia['precio_unidad']\n  carrito[existeEnCarrito] = copia\n} else {\n  carrito.push({\n  id: $('Stock suficiente').first().json.id_producto,\n  nombre: $('Stock suficiente').first().json.nombre,\n  cantidad: cantidadSolicitada,\n  precio_unidad: $('Stock suficiente').first().json.precio,\n  total_pagar: $('Stock suficiente').first().json.precio * cantidadSolicitada\n})\n}\n\nsesion.carrito_temporal = JSON.stringify(carrito)\n\nreturn {\n  json: {\n    sesion\n  }\n}"
      },
