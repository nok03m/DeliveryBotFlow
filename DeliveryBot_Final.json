    {
      "parameters": {
        "jsCode": "const inputJson = $input.first().json;\nconst triggerData = $('Capturar mensaje bot').first()?.json || {};\n\n// 1. Extraemos y preparamos la sesión de Redis\nlet sesionRedis = inputJson.obtener_sesion;\n\n// Si Redis devolvió la sesión como un texto (string), la convertimos a un objeto (JSON)\nif (typeof sesionRedis === 'string' && sesionRedis.trim() !== '') {\n  try {\n    sesionRedis = JSON.parse(sesionRedis);\n  } catch (error) {\n    // Si falla al convertir, asumimos que no hay sesión válida\n    sesionRedis = null; \n  }\n}\n\n// 2. Si realmente no hay sesión (o estaba vacía), inicializamos una nueva\nif (!sesionRedis) {\n  return {\n    telegram_id: inputJson.telegram_id,\n    pantalla_actual: 'inicio',\n    carrito_temporal: [],\n    ultimo_cambio: $now.toISO() \n  };\n} else {\n  // 3. Ya tenemos la sesión existente como un objeto usable\n  \n  // Validamos si fue un clic en un botón (callback_query)\n  if (triggerData.callback_query && triggerData.callback_query.data) {\n    sesionRedis.pantalla_actual = triggerData.callback_query.data;\n  }\n  \n  // Si fue texto, la 'pantalla_actual' que traía sesionRedis se queda intacta.\n\n  // Actualizamos el timestamp de interacción\n  sesionRedis.ultimo_cambio = $now.toISO(); \n\n  // Retornamos la sesión ya actualizada\n  return sesionRedis;\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        -16
      ],
      "id": "6600007e-b255-4924-988b-2883b874911e",
      "name": "Formatar sesion"
