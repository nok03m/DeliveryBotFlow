    {
      "parameters": {
        "jsCode": "// 1. Obtener la cadena de texto del carrito temporal\nconst carritoTexto = $input.first().json.obtener_sesion.carrito_temporal;\n\nlet carritoArreglo = []\n\nif(carritoTexto == ''){\n  return {\n  json: {  \n    total_general: 0,\n    productos: '<br/>No hay productos en el carrito<br/>' \n  }\n};\n}\n\nif(carritoTexto != undefined || carritoTexto != null || carritoTexto != ''){\n    carritoArreglo = JSON.parse(carritoTexto);\n}\n\n// Variables para acumular resultados\nlet granTotal = 0;\nlet productosHtml = \"\"; // Cambiamos el arreglo por una cadena de texto\n\n// 3. Iterar sobre el arreglo\ncarritoArreglo.forEach(item => {\n  // Acumular el total general\n  granTotal += item.total_pagar;\n\n  // 4. Concatenar cada producto dándole formato HTML (puedes ajustar las etiquetas como prefieras)\n  productosHtml += `🛍️ <b>${item.nombre}</b><br>`;\n  productosHtml += `📝 Cantidad: ${item.cantidad}<br>`;\n  productosHtml += `💰 Subtotal: $${item.total_pagar}<br><br>`; \n});\n\n// (Opcional) Si también quieres incluir el total general directamente en el string de HTML:\n// productosHtml += `<b>Total a pagar: $${granTotal}</b>`;\n\n// Estructura final resultando en el objeto solicitado\nreturn {\n  json: {  \n    total_general: granTotal,\n    productos: productosHtml // Ahora devuelve un string HTML en lugar de un Array\n  }\n};"
      },
